# Copy this file to .env and fill in real values - the app reads from .env,
# never from this file. This template intentionally has no values, only
# variable names, so it's safe to commit. See README.md for what each one does.

# --- Port (single process, all services mounted on the same port) ---
PORT=

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGIN=

# --- MongoDB (single cluster backing every service - auth, users, products, orders, payments) ---
MONGO_URI=

# --- Auth service: JWT secrets ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# --- Auth service: OTP behavior ---
OTP_LENGTH=
OTP_EXPIRES_IN_MINUTES=

NODE_ENV=

# --- Payment service: Razorpay Standard Checkout ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
