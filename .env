# Local dev environment. This file is gitignored - never commit real secrets.
# mock flag
USE_MOCK=true


# --- Port (single process, all services mounted on the same port) ---
PORT=3000

# --- MySQL (user-service) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=maako

# --- MongoDB (product-service) ---
MONGO_URI=mongodb://127.0.0.1:27017/maako

# --- Auth service: JWT secrets ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth service: OTP behavior ---
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30

NODE_ENV=development

# --- Payment service: Razorpay Standard Checkout (test mode) ---
RAZORPAY_KEY_ID=rzp_test_TGap41RPGI9VVt
RAZORPAY_KEY_SECRET=rwSkGApeJqEMUhvSmorUS4z1
